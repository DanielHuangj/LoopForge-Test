APP_ENV=dev
PORT=8080
POSTGRES_PASSWORD=CHANGE_ME_local_db_password
DATABASE_URL=postgres://loopforge:CHANGE_ME_local_db_password@localhost:5432/loopforge
SSO_MODE=mock
# OIDC mode only:
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
SESSION_SECRET=CHANGE_ME_use_openssl_rand_base64_48
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=loopforge_session
POST_LOGIN_REDIRECT_URL=/api/v1/auth/me
LOG_LEVEL=info
HEALTH_DB_TIMEOUT_MS=2000
MOCK_SSO_PORT=9090
MOCK_SSO_HOST=127.0.0.1
MOCK_SSO_ISSUER=http://localhost:9090
SSO_NAME_CLAIM=name
SSO_ROLES_CLAIM=roles
SSO_ACCOUNT_STATUS_CLAIM=account_status
SSO_EMPLOYEE_NO_CLAIM=employee_no
SSO_DEPARTMENT_CLAIM=department
