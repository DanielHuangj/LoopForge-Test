{
  "name": "loopforge-base-auth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate-cli.ts",
    "seed:dev": "node --env-file-if-exists=.env --import tsx src/db/seed-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "fastify": "^5.6.2",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "pglite-server": "^0.1.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
